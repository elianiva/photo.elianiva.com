# Copy to .env (gitignored). CI passes the prod values from repo secrets.
#
# ACCESS_ALLOWED_EMAILS — comma-separated allowlist; becomes the Access
# application's `allow` policy and the Worker's own allowlist check.
ACCESS_ALLOWED_EMAILS=you@example.com

# ACCESS_TEAM_DOMAIN — the Zero Trust organization's `auth_domain`, e.g.
# https://your-team.cloudflareaccess.com. Required on every non-dev stage: it
# is where the Access JWKS and `/cdn-cgi/access/*` live, and the Workers
# verify `Cf-Access-Jwt-Assertion` against it.
#
# `pnpm dev` is unaffected by the value here — alchemy.run.ts forces the
# *binding* to '' on the dev stage, which is the documented stand-down.
ACCESS_TEAM_DOMAIN=
