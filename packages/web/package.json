    "effect": "4.0.0",
    "foldkit": "^0.164.0",
    "lucide": "^1.49.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "^0.25.0",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
